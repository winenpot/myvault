# Secrets / vault data - never commit
*.kdbx
*.kdbx.*
*.kdbx-*
*.key
*.keyx
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
*_ed25519
*_rsa
known_hosts
*.bak
*.bak.*

# Env files - .env.example is the only one meant to be tracked
.env
.env.*
!.env.example

# Upstream source + build output (also catches upstream/keepassxc/{build,stage})
upstream/
dist/
