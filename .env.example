# Copy to .env and adjust. One .env for this repo.
# Local working copy of the database (outside the repo).
VAULT_LOCAL=$HOME/Vault/passwords.kdbx
# SSH host alias for the SFTP-only vault user on the server (see ~/.ssh/config).
VAULT_REMOTE_HOST=atpg-vault
# Path inside the SFTP chroot.
VAULT_REMOTE_PATH=/data/passwords.kdbx
# NOTE: the master password is never stored here.
